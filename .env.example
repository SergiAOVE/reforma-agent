# =============================================================
# reforma-agent — example environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit real secrets to the repository.
# =============================================================

# --- Supabase (Phase 1+) ---
# Supabase project URL (safe for the client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Server/worker Supabase URL. May match NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://your-project.supabase.co
# Anon/publishable key (safe for the client, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server / worker only (NEVER expose to the browser) ---
# Service role key: only for the worker and server-side scripts
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Worker (Phase 5+) ---
# agent_jobs polling interval in milliseconds
WORKER_POLL_INTERVAL_MS=5000
# seconds before a processing job is considered stale and claimable again
WORKER_STALE_AFTER_SECONDS=600
# optional: set true for one polling pass in smoke tests
WORKER_RUN_ONCE=false

# --- AI provider (Phase 5+) ---
# Optional: without a key the MockAiProvider is used.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TEXT_MODEL=gpt-4o-mini
# Backward-compatible generic provider key; OPENAI_API_KEY takes precedence.
AI_PROVIDER_API_KEY=

# --- Optional Telegram gateway (Phase 10) ---
# Server-only secret sent by Telegram in X-Telegram-Bot-Api-Secret-Token.
# Use 16-256 chars from A-Z, a-z, 0-9, _ and -.
TELEGRAM_WEBHOOK_SECRET=
# Server-only bot token from BotFather. Required only if the gateway should reply in chat.
TELEGRAM_BOT_TOKEN=
# First-party server API endpoint that receives normalized Telegram command intents.
TELEGRAM_GATEWAY_API_URL=https://your-domain.example/api/gateway/telegram/commands
# Bearer token shared only between the webhook route and the first-party gateway API.
TELEGRAM_GATEWAY_API_TOKEN=

# --- Optional NanoClaw gateway (Phase 11) ---
# Bearer token NanoClaw must send to POST /api/nanoclaw/webhook.
NANOCLAW_WEBHOOK_TOKEN=
# First-party server API endpoint that receives normalized NanoClaw command intents.
NANOCLAW_GATEWAY_API_URL=https://your-domain.example/api/gateway/nanoclaw/commands
# Bearer token shared only between the NanoClaw webhook route and first-party gateway API.
NANOCLAW_GATEWAY_API_TOKEN=
