# =============================================================
# reforma-agent — example environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit real secrets to the repository.
# =============================================================

# --- Supabase (Phase 1+) ---
# Supabase project URL (safe for the client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon/publishable key (safe for the client, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server / worker only (NEVER expose to the browser) ---
# Service role key: only for the worker and server-side scripts
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Worker (Phase 5+) ---
# agent_jobs polling interval in milliseconds
WORKER_POLL_INTERVAL_MS=5000

# --- AI provider (Phase 5+) ---
# Transcription/LLM provider key. Optional: without a key the MockAiProvider is used.
AI_PROVIDER_API_KEY=
