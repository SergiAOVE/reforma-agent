{
  "name": "@reforma/worker",
  "version": "0.0.1",
  "private": true,
  "description": "Worker for AI jobs and long-running tasks (Node.js/TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@reforma/ai": "workspace:*",
    "@reforma/core": "workspace:*",
    "@reforma/db": "workspace:*",
    "@supabase/supabase-js": "^2.110.0"
  }
}
